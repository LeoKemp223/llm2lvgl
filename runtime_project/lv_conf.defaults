LV_COLOR_DEPTH 32

# Runtime
LV_USE_LOG 1
LV_LOG_LEVEL LV_LOG_LEVEL_WARN
LV_LOG_PRINTF 1

# SDL driver
LV_USE_SDL 1
LV_SDL_RENDER_MODE LV_DISPLAY_RENDER_MODE_DIRECT
LV_SDL_BUF_COUNT 1
LV_SDL_ACCELERATED 1
LV_SDL_FULLSCREEN 0
LV_SDL_DIRECT_EXIT 1

# Keep the project small and focused on rapid hand-written UI iteration.
LV_BUILD_EXAMPLES 0
LV_BUILD_DEMOS 0
LV_USE_XML 0
LV_USE_OBJ_NAME 1
LV_USE_LODEPNG 1
LV_USE_FS_POSIX 1
LV_FS_POSIX_LETTER 'A'
LV_FS_POSIX_PATH ""
LV_USE_SNAPSHOT 1

# Fonts used by the page implementations.
LV_FONT_MONTSERRAT_14 1
LV_FONT_MONTSERRAT_24 1
LV_USE_FREETYPE 1

# Stdlib
LV_USE_STDLIB_MALLOC LV_STDLIB_CLIB
LV_USE_STDLIB_STRING LV_STDLIB_CLIB
LV_USE_STDLIB_SPRINTF LV_STDLIB_CLIB

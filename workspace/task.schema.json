{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LVGL Agent Task",
  "type": "object",
  "required": [
    "task_id",
    "page_id",
    "page_name",
    "input",
    "target",
    "generation",
    "reference",
    "validation",
    "export",
    "failure_policy"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "page_name": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object",
      "required": [
        "source_type",
        "html_entry",
        "assets_dir",
        "notes_file"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "html",
            "reference_only"
          ]
        },
        "html_entry": {
          "type": "string"
        },
        "assets_dir": {
          "type": "string"
        },
        "notes_file": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "profile",
        "viewport",
        "color_depth",
        "dpi",
        "language"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "viewport": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "color_depth": {
          "type": "integer",
          "minimum": 1
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "required": [
        "output_c",
        "output_h",
        "component_mode",
        "allow_custom_draw",
        "allow_freetype",
        "allow_filesystem_assets"
      ],
      "properties": {
        "output_c": {
          "type": "string",
          "minLength": 1
        },
        "output_h": {
          "type": "string",
          "minLength": 1
        },
        "component_mode": {
          "type": "string",
          "enum": [
            "portable",
            "simulator_first"
          ]
        },
        "allow_custom_draw": {
          "type": "boolean"
        },
        "allow_freetype": {
          "type": "boolean"
        },
        "allow_filesystem_assets": {
          "type": "boolean"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "image",
        "render_from_html"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "render_from_html": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "pixel_diff_threshold",
        "max_diff_ratio",
        "max_mean_abs_diff",
        "require_size_match"
      ],
      "properties": {
        "pixel_diff_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "max_diff_ratio": {
          "type": "number",
          "minimum": 0
        },
        "max_mean_abs_diff": {
          "type": "number",
          "minimum": 0
        },
        "require_size_match": {
          "type": "boolean"
        }
      }
    },
    "export": {
      "type": "object",
      "required": [
        "bundle_dir",
        "include_assets",
        "include_porting_md"
      ],
      "properties": {
        "bundle_dir": {
          "type": "string",
          "minLength": 1
        },
        "include_assets": {
          "type": "boolean"
        },
        "include_porting_md": {
          "type": "boolean"
        }
      }
    },
    "failure_policy": {
      "type": "object",
      "required": [
        "max_iterations",
        "stop_on_build_error",
        "stop_on_missing_reference",
        "stop_on_validation_script_error",
        "stop_on_portability_error"
      ],
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "stop_on_build_error": {
          "type": "boolean"
        },
        "stop_on_missing_reference": {
          "type": "boolean"
        },
        "stop_on_validation_script_error": {
          "type": "boolean"
        },
        "stop_on_portability_error": {
          "type": "boolean"
        }
      }
    },
    "compat": {
      "type": "object",
      "required": [
        "legacy_page_flow_task"
      ],
      "properties": {
        "legacy_page_flow_task": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "task_id": "token_landing_v1",
  "page_id": "token_landing",
  "page_name": "Token Landing Page",
  "input": {
    "source_type": "html",
    "html_entry": "input/index.html",
    "assets_dir": "input/assets",
    "notes_file": "input/notes.md"
  },
  "target": {
    "profile": "../../../profiles/sim_1280x800.json",
    "viewport": {
      "width": 1280,
      "height": 800
    },
    "color_depth": 32,
    "dpi": 160,
    "language": "zh-CN"
  },
  "generation": {
    "output_c": "../../../m1_real_project/src/token_page.c",
    "output_h": "../../../m1_real_project/src/token_page.h",
    "component_mode": "portable",
    "allow_custom_draw": false,
    "allow_freetype": false,
    "allow_filesystem_assets": true
  },
  "reference": {
    "image": "../../../m1_real_project/references/token-reference.png",
    "render_from_html": false
  },
  "validation": {
    "pixel_diff_threshold": 16,
    "max_diff_ratio": 0.22,
    "max_mean_abs_diff": 26.0,
    "require_size_match": false
  },
  "export": {
    "bundle_dir": "export/portable_bundle",
    "include_assets": true,
    "include_porting_md": true
  },
  "failure_policy": {
    "max_iterations": 8,
    "stop_on_build_error": true,
    "stop_on_missing_reference": true,
    "stop_on_validation_script_error": true,
    "stop_on_portability_error": true
  },
  "compat": {
    "legacy_page_flow_task": "token"
  },
  "notes": [
    "Compatibility task mapped to the existing token page while the new pipeline is being introduced.",
    "This task is expected to fail portability lint until demo-page assumptions are removed."
  ]
}
